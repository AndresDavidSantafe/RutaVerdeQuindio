<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox style="-fx-padding: 12; -fx-background-color: #E8F4EA;">
            <Label text="RutaVerde Quindío" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Gestión de clientes, guías, actividades, paquetes y reservas"/>
        </VBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Clientes" closable="false">
                    <content>
                        <fx:include source="clientes.fxml"/>
                    </content>
                </Tab>
                <Tab text="Guías" closable="false">
                    <content>
                        <fx:include source="guias.fxml"/>
                    </content>
                </Tab>
                <Tab text="Actividades" closable="false">
                    <content>
                        <fx:include source="actividades.fxml"/>
                    </content>
                </Tab>
                <Tab text="Paquetes" closable="false">
                    <content>
                        <fx:include source="paquetes.fxml"/>
                    </content>
                </Tab>
                <Tab text="Reservas" closable="false">
                    <content>
                        <fx:include source="reservas.fxml"/>
                    </content>
                </Tab>
                <Tab text="Reportes" closable="false">
                    <content>
                        <fx:include source="reportes.fxml"/>
                    </content>
                </Tab>
                <Tab text="Agencia" closable="false">
                    <content>
                        <fx:include source="agencia.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
